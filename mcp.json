{
  "mcpServers": {
    "google-video-search-flashdata": {
      "command": "npx",
      "args": [
        "--yes",
        "@flashdata-dev/google-video-search@0.1.0",
        "mcp"
      ],
      "env": {
        "FLASHDATA_API_KEY": "${env:FLASHDATA_API_KEY}"
      },
      "type": "stdio"
    }
  }
}
